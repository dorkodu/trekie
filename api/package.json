{
  "name": "@trekie/api",
  "private": true,
  "type": "module",
  "module": "index.ts",
  "version": "0.0.0",
  "scripts": {
    "dev": "bun run --hot index.ts",
    "build": "rimraf ./dist && tsc",
    "lint": "eslint --cache --ext \".js,.ts,.tsx\" src",
    "type-check": "tsc",
    "test:unit": "bun test run --dir ./src/test/unit",
    "test:unit:watch": "bun test watch --dir ./src/test/unit",
    "test:integration": "bun test run --dir ./src/test/integration",
    "test:integration:watch": "bun test watch --dir ./src/test/integration",
    "migrate:make": "pnpm knex migrate:make migrate_name -x ts --knexfile ./src/knexfile.ts",
    "migrate:dev:latest": "NODE_ENV=development knex migrate:latest --knexfile ./src/knexfile.ts",
    "migrate:dev:rollback": "NODE_ENV=development knex migrate:rollback --all --knexfile ./src/knexfile.ts",
    "migrate:dev:up": "NODE_ENV=development knex migrate:up --knexfile ./src/knexfile.ts",
    "migrate:dev:down": "NODE_ENV=development knex migrate:down --knexfile ./src/knexfile.ts",
    "migrate:dev:reset": "pnpm migrate:dev:rollback && pnpm migrate:dev:latest",
    "migrate:prod:latest": "NODE_ENV=production knex migrate:latest --knexfile ./dist/knexfile.js",
    "migrate:prod:rollback": "NODE_ENV=production knex migrate:rollback --all --knexfile ./dist/knexfile.js",
    "migrate:prod:up": "NODE_ENV=production knex migrate:up --knexfile ./dist/knexfile.js",
    "migrate:prod:down": "NODE_ENV=production knex migrate:down --knexfile ./dist/knexfile.js",
    "migrate:prod:reset": "pnpm migrate:prod:rollback && pnpm migrate:prod:latest",
    "email:dev": "email dev"
  },
  "dependencies": {
    "@react-email/components": "^0.0.21",
    "@react-email/render": "^0.0.16",
    "@trekie/web": "workspace:*",
    "@trpc/client": "npm:@trpc/client@next",
    "@trpc/react-query": "npm:@trpc/react-query@next",
    "@trpc/server": "npm:@trpc/server@next",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "nodemailer": "^6.9.14",
    "postgres": "^3.4.4",
    "react-email": "^2.1.5",
    "zod": "^3.23.8"
  },
  "peerDependencies": {
    "typescript": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.33",
    "esbuild": "^0.17.10",
    "eslint": "^8.56.0",
    "typescript": "^5.4.0",
    "@types/bun": "^1.0.12",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nodemailer": "^6.4.14"
  },
  "publishConfig": {
    "access": "restricted"
  }
}
