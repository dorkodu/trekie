{
  "name": "trekie",
  "version": "0.0.1",
  "scripts": {
    "build:api": "cd ./api && pnpm build",
    "build:web": "cd ./web && pnpm build",
    "build": "run-p build:*",
    "dev:api": "cd ./api && pnpm dev",
    "dev:web": "cd ./web && pnpm dev",
    "dev": "run-p dev:*",
    "warm:api": "cd ./api && pnpm i",
    "warm:web": "cd ./web && pnpm i",
    "warm": "pnpm i && run-p warm:*",
    "start": "node ./api/dist/index.js"
  },
  "dependencies": {
    "npm-run-all": "^4.1.5"
  }
}